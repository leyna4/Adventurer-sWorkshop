  specialPanel: {fileID: 2891397005564450493, guid: 902c6e91df62db4458971e27ca3ead28, type: 3}
  goalContainer: {fileID: 1888339260}
  goalItemPrefab: {fileID: -4983774406986113626, guid: 902c6e91df62db4458971e27ca3ead28, type: 3}
  customerVisual: {fileID: 1856550997}
  itemImage: {fileID: 1070101141}
  dialogueText: {fileID: 1083183916}
  brokenItemSprite: {fileID: -7445561438212924015, guid: 055b184c6fab215458def9de40113b5e, type: 3}
  repairedItemSprite: {fileID: -7600320551079661094, guid: 415c950cc0092204f80f51f3049a47c3, type: 3}
  dialogueBox: {fileID: 622263566}
  choiceButtons: {fileID: 333576441}
  choiceButton1: {fileID: 170466101}
  choiceButton2: {fileID: 954325420}
  customers:
  - intro1: "\"Merhaba usta...Bu k\u0131l\u0131\xE7 \xFC\xE7 gece boyunca u\u011Fuldad\u0131\u2026
      art\u0131k ruhu \xE7atlad\u0131.\""
    intro2: "\"Bu eski k\u0131l\u0131c\u0131m\u0131 tamir edebilir misin?\""
    customerSprite: {fileID: -2149228961609127317, guid: 33eef272256d26844985312c7aa6c3cd, type: 3}
    brokenSprite: {fileID: -7445561438212924015, guid: 055b184c6fab215458def9de40113b5e, type: 3}
    repairedSprite: {fileID: -7600320551079661094, guid: 415c950cc0092204f80f51f3049a47c3, type: 3}
  - intro1: "\"Merhaba... Elimdeki yay bu diyar\u0131n en iyisi ama art\u0131k y\u0131prand\u0131
      ve tamir gerekli. \" "
    intro2: "\"Yay\u0131m\u0131 tamir edebilecek misin?\""
    customerSprite: {fileID: 7614938409016449792, guid: 605e07fe2f4391148b89e4100854d736, type: 3}
    brokenSprite: {fileID: -3014062419912477767, guid: 9fca297feb2aee842b1557a1ff843bbf, type: 3}
    repairedSprite: {fileID: -753856620418040090, guid: 0bba8fd8b54df704fb11c266654d0ce1, type: 3}
  - intro1: "\"Merhaba usta...Asam b\xFCy\xFC yapm\u0131yor\u2026 sadece karanl\u0131k
      f\u0131s\u0131ld\u0131yor.\" "
    intro2: "\"Bu i\u015Ferden anlar m\u0131s\u0131n? Yoksa bana yeni bir asa bor\xE7lu
      olursun.\""
    customerSprite: {fileID: -6069152061595868354, guid: ae83c780f062d9346859a3c94e852776, type: 3}
    brokenSprite: {fileID: -6236417510276334351, guid: da51f51680d39b04aa109d90e92f4004, type: 3}
    repairedSprite: {fileID: 4380575094756624700, guid: 04606782105f51148b831cbd75255955, type: 3}
  - intro1: "\"Merhaba usta... Sihirli k\xFCrem Gelece\u011Fi g\xF6stermeyi b\u0131rakt\u0131\u2026
      sadece ge\xE7mi\u015Fi tekrar ediyor.\" "
    intro2: '"Tamir edebilir misin?"'
    customerSprite: {fileID: 5183169574928690679, guid: db2c5cb7dcccf754bb4744779a2a4d97, type: 3}
    brokenSprite: {fileID: -8680523118341878133, guid: f02b27a1283ee6e4e9ba9cbf68280865, type: 3}
    repairedSprite: {fileID: 7048354598001274602, guid: 0b752fcca9987ae46881f6503987cafc, type: 3}
  - intro1: "\"Merhaba...Biricik Ejderha Z\u0131rh\u0131m...Alevlere dayan\u0131rd\u0131\u2026
      \u015Fimdi k\u0131v\u0131lc\u0131ma bile titriyor.\" "
    intro2: "\"Bu z\u0131rh\u0131 tamir edebilir misin?\""
    customerSprite: {fileID: -985824357495178350, guid: 09c5fbdd25a08574d8fc482327a50d8e, type: 3}
    brokenSprite: {fileID: 4196297104562640181, guid: e624063391946e64a83eb88936109839, type: 3}
    repairedSprite: {fileID: 7849947679778526942, guid: 82bda1d89a319cf48bdbaeb570df1fd3, type: 3}
  - intro1: "\"Merhaba...Elimde Antik bir kitap var. Sayfalar bo\u015F de\u011Fil\u2026
      ama kelimeler ka\xE7\u0131yor.\" "
    intro2: '"Bunu tamir edebilecek misin?"'
    customerSprite: {fileID: 6887516101734258562, guid: 36367a1c23615264d8825db0922ec4eb, type: 3}
    brokenSprite: {fileID: 14400421564034860, guid: aee1850588ab86d47bf4319dc90a665b, type: 3}
    repairedSprite: {fileID: 3405490765357548581, guid: 1b975f1875714c841affe0004e31ad0f, type: 3}
  - intro1: "\"Merhaba usta...Bu saat zaman\u0131 durdururdu\u2026 \u015Fimdi kendisi
      durmu\u015F.\" "
    intro2: '"Tamir edebilir misin?"'
    customerSprite: {fileID: 6668333386924990259, guid: e067fe3f5a08b51448acb7608eab2db6, type: 3}
    brokenSprite: {fileID: 433855545063464014, guid: ddae4f33773b77e48b935df7e520d1d5, type: 3}
    repairedSprite: {fileID: 6767117142185961649, guid: 8d073ccb89bf15347a5d3c7f6e53c5a7, type: 3}
  - intro1: "\"Merhaba usta...Bu han\xE7er g\xF6lgeleri keserdi\u2026 art\u0131k
      kendi g\xF6lgesini bile de\u011Fil.\" "
    intro2: "\"Bu han\xE7eri tamir edebilir misin?\""
    customerSprite: {fileID: 433243580467930426, guid: 987d29054a10cd44da4c43493eb8fd06, type: 3}
    brokenSprite: {fileID: -1820201662342613760, guid: 3c00ea375215f434b8c1f364ad2ea37e, type: 3}
    repairedSprite: {fileID: 5466714445505000125, guid: 34577ef26b44b034599c0c8e014499c2, type: 3}
  - intro1: "\"Merhaba... Bu kehanetlerin kolyesi. Eskiden kalbimle birlikte atard\u0131\u2026
      \u015Fimdi buz gibi.\" "
    intro2: '"Tamir edebilir misin?"'
    customerSprite: {fileID: 7172396016052967985, guid: dcc881ef6f3766a409e3d1260ba55c12, type: 3}
    brokenSprite: {fileID: 7735414121607037782, guid: c7f0292d23a891242aa90a2d4878aa6b, type: 3}
    repairedSprite: {fileID: 2015828251553377016, guid: a8a93b7a9e1eaae44b08cf67cace4e84, type: 3}
  - intro1: "\"Merhaba usta...Bu y\xFCz\xFC\u011F\xFC takt\u0131\u011F\u0131m g\xFCnden
      beri g\xF6lgem bana ait de\u011Fil. Bir \u015Feyler yanl\u0131\u015F...\" "
    intro2: "\"Bu y\xFCz\xFC\u011F\xFC tamir edebilir misin?\""
    customerSprite: {fileID: 6358587171456139685, guid: 2d5a10ea91df5ba45838b207c2b0adb6, type: 3}
    brokenSprite: {fileID: -2395402643667279590, guid: b2d3f0b2c85ca4544b06c6540d9ecd0d, type: 3}
    repairedSprite: {fileID: 2732655124047119293, guid: 990e964ab3b377c4f89b2103c713395c, type: 3}
